{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "deno --allow-env --allow-sys --allow-read --allow-write --allow-run --allow-ffi vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "@harmless/ht-cookie": "jsr:@harmless/ht-cookie@^0.3.0",
    "@preact-icons/tb": "jsr:@preact-icons/tb@^1.0.14",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.9.1",
    "@prisma/client": "npm:@prisma/client@^7.9.1",
    "@prisma/extension-accelerate": "npm:@prisma/extension-accelerate@^3.0.1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@types/node": "npm:@types/node@^25.9.5",
    "@types/pg": "npm:@types/pg@^8.20.4",
    "daisyui": "npm:daisyui@^5.7.16",
    "date-fns": "npm:date-fns@^4.4.0",
    "dotenv": "npm:dotenv@^17.4.2",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "main.ts": "npm:main.ts@^1.0.0",
    "preact": "npm:preact@^10.29.8",
    "@preact/signals": "npm:@preact/signals@^2.11.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "prisma": "npm:prisma@^7.9.1",
    "vite": "npm:vite@^7.3.6",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "deploy": { "org": "gibbygano", "app": "yarnadelphia" },
  "allowScripts": [
    "npm:@prisma/engines@7.1.0",
    "npm:@prisma/engines@7.3.0",
    "npm:@prisma/engines@7.6.0",
    "npm:@prisma/engines@7.8.0",
    "npm:esbuild@0.25.7",
    "npm:esbuild@0.27.2",
    "npm:esbuild@0.27.4",
    "npm:esbuild@0.27.7",
    "npm:prisma@7.1.0",
    "npm:prisma@7.3.0",
    "npm:prisma@7.6.0",
    "npm:prisma@7.8.0"
  ]
}
