{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "deno --allow-env --allow-sys --allow-read --allow-write --allow-run prisma generate && vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "@harmless/ht-cookie": "jsr:@harmless/ht-cookie@^0.3.0",
    "@preact-icons/tb": "jsr:@preact-icons/tb@^1.0.14",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.6.0",
    "@prisma/client": "npm:@prisma/client@^7.6.0",
    "@prisma/extension-accelerate": "npm:@prisma/extension-accelerate@^3.0.1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/http": "jsr:@std/http@^1.0.25",
    "@types/node": "npm:@types/node@^25.5.0",
    "@types/pg": "npm:@types/pg@^8.20.0",
    "daisyui": "npm:daisyui@^5.5.19",
    "dotenv": "npm:dotenv@^17.3.1",
    "fresh": "jsr:@fresh/core@^2.2.2",
    "preact": "npm:preact@^10.29.0",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "prisma": "npm:prisma@^7.6.0",
    "vite": "npm:vite@^7.3.1",
    "tailwindcss": "npm:tailwindcss@^4.2.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.2"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "deploy": {
    "org": "gibbygano",
    "app": "yarnadelphia"
  },
  "allowScripts": [
    "npm:@prisma/engines@7.1.0",
    "npm:@prisma/engines@7.3.0",
    "npm:@prisma/engines@7.6.0",
    "npm:esbuild@0.25.7",
    "npm:esbuild@0.27.2",
    "npm:esbuild@0.27.4",
    "npm:prisma@7.1.0",
    "npm:prisma@7.3.0",
    "npm:prisma@7.6.0"
  ]
}
